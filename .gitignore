vendor/
composer.lock
.idea/
.phpunit.cache/
.php-cs-fixer.cache

# session notes and audit state - local to this clone, never published
CLAUDE.local.md

# Secrets, and the envsync template with them: this package is shippable, so
# .env.tpl stays local - it holds no values, but it names the vault and the item
# convention - and the committed .env.example documents the variables instead.
#
# Deliberately not anchored with a leading slash, so these match at any depth:
# an environment file can legitimately sit in a subdirectory rather than at the root.
# .env.* covers the named variants; a committed .env.example stays tracked.
.env
.env.*
!.env.example

# NTFS alternate data stream left behind when a file is copied from Windows into
# WSL - it records the zone the download came from and is of no use here. Also
# covered by ~/.config/git/ignore on this machine, which a clone elsewhere would
# not have.
*:Zone.Identifier
